ARG TARGETARCH=amd64
ARG CUDA_BASE_IMAGE
ARG CPU_BASE_IMAGE
FROM --platform=linux/amd64 ${CUDA_BASE_IMAGE} AS base-amd64
FROM --platform=linux/arm64 ${CUDA_BASE_IMAGE} AS base-arm64
FROM ${CPU_BASE_IMAGE} AS base-ppc64le
FROM ${CPU_BASE_IMAGE} AS base-s390x

FROM base-${TARGETARCH}
USER root

RUN sed -i.bak 's/include-system-site-packages = false/include-system-site-packages = true/' /opt/app-root/pyvenv.cfg

RUN dnf install -y skopeo && dnf clean all

COPY LICENSE.md /licenses/lm-evaluation-harness.md

WORKDIR /opt/app-root/src
COPY . .

RUN pip install --no-cache-dir ".[api,ifeval,math,ibm_watsonx_ai]"

RUN chmod -R og+rX /opt/app-root/src/

USER default

RUN mkdir /opt/app-root/src/hf_home && chmod g+rwx /opt/app-root/src/hf_home                     && \
    mkdir /opt/app-root/src/output && chmod g+rwx /opt/app-root/src/output                       && \
    mkdir /opt/app-root/src/my_tasks && chmod g+rwx /opt/app-root/src/my_tasks                   && \
    mkdir -p /opt/app-root/src/my_catalogs/cards && chmod -R g+rwx /opt/app-root/src/my_catalogs && \
    mkdir -p /opt/app-root/src/.cache

ENV PATH="/opt/app-root/bin:/opt/app-root/src/.local/bin/:/opt/app-root/src/bin:/usr/local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

RUN python -c 'from lm_eval.tasks.unitxt import task; import os.path; print("class: !function " + task.__file__.replace("task.py", "task.Unitxt"))' > ./my_tasks/unitxt

ENV PYTHONPATH=/opt/app-root/src/.local/lib/python3.12/site-packages:/opt/app-root/src/lm-evaluation-harness:/opt/app-root/src:/opt/app-root/src/server
ENV HF_HOME=/opt/app-root/src/hf_home
ENV UNITXT_CATALOGS=/opt/app-root/src/my_catalogs

USER 65532:65532
CMD ["/opt/app-root/bin/python"]

LABEL name="rhoai/odh-ta-lmes-job-rhel9" \
      com.redhat.component="odh-ta-lmes-job-rhel9" \
      io.k8s.display-name="odh-ta-lmes-job-rhel9" \
      io.k8s.description="LMEval serves as a secure, batch-oriented execution environment for language model evaluations with lm-evaluation-harness, providing a standardized runtime, Unitxt framework integration, and support for custom tasks and metrics. It is designed for one-shot evaluation workloads, handling model testing with output management." \
      description="LMEval serves as a secure, batch-oriented execution environment for language model evaluations with lm-evaluation-harness, providing a standardized runtime, Unitxt framework integration, and support for custom tasks and metrics. It is designed for one-shot evaluation workloads, handling model testing with output management." \
      summary="LMEval is a secure, batch-oriented runtime for one-shot language model evaluations" \
      com.redhat.license_terms="https://www.redhat.com/licenses/Red_Hat_Standard_EULA_20191108.pdf"
